{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/announcement", "destination": "/announcement.html" },
    { "source": "/christians", "destination": "/christians.html" },
    { "source": "/find", "destination": "/find.html" },
    { "source": "/letter", "destination": "/letter.html" },
    { "source": "/record", "destination": "/record.html" },
    { "source": "/room-1001", "destination": "/room-1001.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow, max-snippet:-1, max-image-preview:large" }
      ]
    }
  ]
}
