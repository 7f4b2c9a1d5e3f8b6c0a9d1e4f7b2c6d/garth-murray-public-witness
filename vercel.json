{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/a16-harvest", "destination": "/a16-harvest.html" },
    { "source": "/announcement", "destination": "/announcement.html" },
    { "source": "/christians", "destination": "/christians.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/find", "destination": "/find.html" },
    { "source": "/letter", "destination": "/letter.html" },
    { "source": "/record", "destination": "/record.html" },
    { "source": "/room-1001", "destination": "/room-1001.html" },
    { "source": "/witness", "destination": "/record.html" },
    { "source": "/witness.html", "destination": "/record.html" },
    { "source": "/proclamations", "destination": "/proclamations.html" },
    { "source": "/press", "destination": "/press.html" },
    { "source": "/work", "destination": "/work.html" },
    { "source": "/archive", "destination": "/archive.html" },
    { "source": "/docs/auroraweave/:path*", "destination": "/docs/aurorweave/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow, max-snippet:-1, max-image-preview:large" }
      ]
    }
  ]
}
